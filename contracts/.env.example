# Deployer wallet — generate via the PHASE6_DEPLOYER_KEY_SETUP.md runbook.
# Used by hardhat to deploy Voting.sol and (as a Wrangler secret) by the API
# to anchor votes on-chain. Leave blank until you run the deploy.
DEPLOYER_PRIVATE_KEY=REPLACE_WITH_YOUR_AMOY_PRIVATE_KEY
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Filled in after `npx hardhat run scripts/deploy-amoy.ts --network amoy`.
# Copy this address to the API worker: `wrangler secret put VOTING_CONTRACT_ADDRESS`
VOTING_CONTRACT_ADDRESS=
