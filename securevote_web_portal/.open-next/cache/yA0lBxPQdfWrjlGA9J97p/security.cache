2%;top:38%;left:4%\"><span class=\"status-dot h-1.5 w-1.5 rounded-full bg-[var(--teal)]\"></span>Standard</span></div></div><section id=\"controls\" class=\"mt-16 grid gap-6 md:grid-cols-2 xl:grid-cols-3 reveal-up reveal-slow reveal-delay-2\"><article class=\"group glass-panel ghost-border relative overflow-hidden rounded-3xl p-7 card-hover\"><div class=\"pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--primary)]/50 to-transparent opacity-0 transition group-hover:opacity-100\"></div><div class=\"mb-6 flex items-center justify-between\"><div class=\"grid h-14 w-14 place-items-center rounded-2xl bg-[var(--primary)]/12 text-[var(--primary)] transition group-hover:scale-110\"><span class=\"material-symbols-outlined text-[26px]\" style=\"font-variation-settings:&quot;FILL&quot; 1\">encrypted</span></div><span class=\"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] text-[var(--red)] border-[var(--red)]/30 bg-[var(--red)]/10\"><span class=\"status-dot h-1.5 w-1.5 rounded-full bg-[var(--red)]\"></span>Critical</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">End-to-End Ballot Encryption</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Votes are encrypted at origin and never exposed in plaintext across transport, storage, or tally pipelines.</p></article><article class=\"group glass-panel ghost-border relative overflow-hidden rounded-3xl p-7 card-hover\"><div class=\"pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--primary)]/50 to-transparent opacity-0 transition group-hover:opacity-100\"></div><div class=\"mb-6 flex items-center justify-between\"><div class=\"grid h-14 w-14 place-items-center rounded-2xl bg-[var(--primary)]/12 text-[var(--primary)] transition group-hover:scale-110\"><span class=\"material-symbols-outlined text-[26px]\" style=\"font-variation-settings:&quot;FILL&quot; 1\">key</span></div><span class=\"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] text-[var(--red)] border-[var(--red)]/30 bg-[var(--red)]/10\"><span class=\"status-dot h-1.5 w-1.5 rounded-full bg-[var(--red)]\"></span>Critical</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Hardware-Backed Key Management</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Cryptographic keys are isolated with strict rotation policies and tamper-evident access controls.</p></article><article class=\"group glass-panel ghost-border relative overflow-hidden rounded-3xl p-7 card-hover\"><div class=\"pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--primary)]/50 to-transparent opacity-0 transition group-hover:opacity-100\"></div><div class=\"mb-6 flex items-center justify-between\"><div class=\"grid h-14 w-14 place-items-center rounded-2xl bg-[var(--primary)]/12 text-[var(--primary)] transition group-hover:scale-110\"><span class=\"material-symbols-outlined text-[26px]\" style=\"font-variation-settings:&quot;FILL&quot; 1\">monitoring</span></div><span class=\"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] text-[var(--amber)] border-[var(--amber)]/30 bg-[var(--amber)]/10\"><span class=\"status-dot h-1.5 w-1.5 rounded-full bg-[var(--amber)]\"></span>High</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Continuous Threat Monitoring</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Live anomaly detection and risk scoring provide rapid incident response across election windows.</p></article><article class=\"group glass-panel ghost-border relative overflow-hidden rounded-3xl p-7 card-hover\"><div class=\"pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--primary)]/50 to-transparent opacity-0 transition group-hover:opacity-100\"></div><div class=\"mb-6 flex items-center justify-between\"><div class=\"grid h-14 w-14 place-items-center rounded-2xl bg-[var(--primary)]/12 text-[var(--primary)] transition group-hover:scale-110\"><span class=\"material-symbols-outlined text-[26px]\" style=\"font-variation-settings:&quot;FILL&quot; 1\">admin_panel_settings</span></div><span class=\"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] text-[var(--amber)] border-[var(--amber)]/30 bg-[var(--amber)]/10\"><span class=\"status-dot h-1.5 w-1.5 rounded-full bg-[var(--amber)]\"></span>High</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Zero-Trust Access</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Administrative actions require layered verification, scoped privileges, and full audit traceability.</p></article><article class=\"group glass-panel ghost-border relative overflow-hidden rounded-3xl p-7 card-hover\"><div class=\"pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--primary)]/50 to-transparent opacity-0 transition group-hover:opacity-100\"></div><div class=\"mb-6 flex items-center justify-between\"><div class=\"grid h-14 w-14 place-items-center rounded-2xl bg-[var(--primary)]/12 text-[var(--primary)] transition group-hover:scale-110\"><span class=\"material-symbols-outlined text-[26px]\" style=\"font-variation-settings:&quot;FILL&quot; 1\">verified_user</span></div><span class=\"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] text-[var(--teal)] border-[var(--teal)]/30 bg-[var(--teal)]/10\"><span class=\"status-dot h-1.5 w-1.5 rounded-full bg-[var(--teal)]\"></span>Standard</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Independent Verifiability</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Public receipts and Merkle proofs allow independent verification without disclosing voter identity.</p></article><article class=\"group glass-panel ghost-border relative overflow-hidden rounded-3xl p-7 card-hover\"><div class=\"pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[var(--primary)]/50 to-transparent opacity-0 transition group-hover:opacity-100\"></div><div class=\"mb-6 flex items-center justify-between\"><div class=\"grid h-14 w-14 place-items-center rounded-2xl bg-[var(--primary)]/12 text-[var(--primary)] transition group-hover:scale-110\"><span class=\"material-symbols-outlined text-[26px]\" style=\"font-variation-settings:&quot;FILL&quot; 1\">history_toggle_off</span></div><span class=\"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.12em] text-[var(--teal)] border-[var(--teal)]/30 bg-[var(--teal)]/10\"><span class=\"status-dot h-1.5 w-1.5 rounded-full bg-[var(--teal)]\"></span>Standard</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Immutable Audit Trails</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Critical election events are recorded in append-only logs for transparent post-election review.</p></article></section><section class=\"mt-16 reveal-up reveal-slow reveal-delay-2\"><div class=\"glass-panel ghost-border relative overflow-hidden rounded-[2rem] p-7 md:p-10\"><div class=\"pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[var(--primary)]/10 blur-[90px]\"></div><div class=\"relative flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between\"><div><p class=\"inline-flex items-center gap-2 rounded-full border border-[var(--teal)]/25 bg-[var(--teal)]/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-[var(--teal)]\"><span class=\"status-dot h-1.5 w-1.5 rounded-full bg-[var(--teal)]\"></span>Tamper-Evident Chain</p><h2 class=\"mt-4 text-3xl font-extrabold tracking-tight md:text-4xl\">The Verification Chain</h2><p class=\"mt-3 max-w-2xl text-base leading-relaxed text-[var(--text-muted)]\">Every ballot is bound into a hash chain that makes tampering detectable at any link through public proof.</p></div></div><div class=\"relative mt-10 grid gap-3 md:grid-cols-4\"><div class=\"pointer-events-none absolute left-[12%] right-[12%] top-1/2 hidden h-px bg-gradient-to-r from-[var(--primary)]/50 via-[var(--secondary)]/50 to-[var(--teal)]/50 md:block\"></div><div class=\"relative flex flex-col items-center rounded-2xl border border-[var(--border-default)] bg-[var(--surface-container)]/70 p-5 text-center card-hover\"><div class=\"grid h-12 w-12 place-items-center rounded-xl brand-gradient glow-brand\"><span class=\"material-symbols-outlined text-white\" style=\"font-variation-settings:&quot;FILL&quot; 1\">how_to_vote</span></div><p class=\"mt-3 font-mono text-[10px] font-bold tracking-[0.18em] text-[var(--text-muted)]\">NODE <!-- -->1</p><p class=\"mt-1 text-sm font-extrabold tracking-tight\">Vote</p><p class=\"mt-1 font-mono text-[10px] text-[var(--text-tertiary)]\">a<!-- --> <!-- -->0xffff<!-- -->...</p></div><div class=\"relative flex flex-col items-center rounded-2xl border border-[var(--border-default)] bg-[var(--surface-container)]/70 p-5 text-center card-hover\"><div class=\"grid h-12 w-12 place-items-center rounded-xl brand-gradient glow-brand\"><span class=\"material-symbols-outlined text-white\" style=\"font-variation-settings:&quot;FILL&quot; 1\">account_tree</span></div><p class=\"mt-3 font-mono text-[10px] font-bold tracking-[0.18em] text-[var(--text-muted)]\">NODE <!-- -->2</p><p class=\"mt-1 text-sm font-extrabold tracking-tight\">Merkle Root</p><p class=\"mt-1 font-mono text-[10px] text-[var(--text-tertiary)]\">b<!-- --> <!-- -->0xffff<!-- -->...</p></div><div class=\"relative flex flex-col items-center rounded-2xl border border-[var(--border-default)] bg-[var(--surface-container)]/70 p-5 text-center card-hover\"><div class=\"grid