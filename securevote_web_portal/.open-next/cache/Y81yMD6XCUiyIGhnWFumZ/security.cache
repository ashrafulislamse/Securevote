{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/security/layout,_N_T_/security/page,_N_T_/security"},"segmentPaths":["/_tree","/_full","/security/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"h-full antialiased\" data-theme=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1hln_88z7nsa8.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/19mx3mg6lkumu.js\" async=\"\"></script><script src=\"/_next/static/chunks/08ttfj81-47mu.js\" async=\"\"></script><script src=\"/_next/static/chunks/0td_q_jvg2olo.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-1ht71va82inkw.js\" async=\"\"></script><script src=\"/_next/static/chunks/06-w6o6puomke.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/1cplzkomwqb35.js\" async=\"\" crossorigin=\"\"></script><title>SecureVote Web Portal</title><meta name=\"description\" content=\"SecureVote admin, verifier, and public web experience.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col bg-background text-foreground\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"relative min-h-screen overflow-hidden bg-background text-foreground\"><div class=\"pointer-events-none absolute -left-24 top-20 h-[460px] w-[460px] rounded-full bg-[var(--primary)]/18 blur-[130px]\"></div><div class=\"pointer-events-none absolute -right-20 top-[35%] h-[420px] w-[420px] rounded-full bg-[var(--tertiary)]/16 blur-[120px]\"></div><div class=\"dot-grid absolute inset-0 opacity-20\"></div><header class=\"fixed inset-x-0 top-0 z-30 border-b border-[var(--border-default)] bg-[var(--surface-overlay)] backdrop-blur-xl\"><div class=\"mx-auto flex h-20 max-w-7xl items-center justify-between px-6 md:px-10\"><div class=\"flex items-center gap-3\"><div class=\"brand-gradient grid h-10 w-10 place-items-center rounded-xl\"><span class=\"material-symbols-outlined text-white\" style=\"font-variation-settings:&quot;FILL&quot; 1\">shield_lock</span></div><p class=\"text-2xl font-extrabold tracking-tight\">SecureVote Security</p></div><nav class=\"hidden items-center gap-8 md:flex\"><a class=\"text-[11px] font-bold uppercase tracking-[0.15em] text-[var(--text-muted)] transition hover:text-[var(--text-primary)]\" href=\"/\">Home</a><a class=\"text-[11px] font-bold uppercase tracking-[0.15em] text-[var(--text-primary)]\" href=\"/security\">Security</a><a class=\"text-[11px] font-bold uppercase tracking-[0.15em] text-[var(--text-muted)] transition hover:text-[var(--text-primary)]\" href=\"/verifier\">Verifier</a></nav><div class=\"flex items-center gap-3\"><button type=\"button\" aria-label=\"Switch to light mode\" title=\"Switch to light mode\" class=\"relative inline-flex h-8 w-12 items-center rounded-full border border-[var(--border-default)] bg-[var(--surface-high)] px-1 transition hover:border-[var(--border-strong)]\"><span class=\"absolute top-1 grid h-6 w-6 place-items-center rounded-full bg-[var(--surface)] text-[var(--text-secondary)] shadow-[0_2px_10px_rgba(0,0,0,0.25)] transition-all left-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-moon h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401\"></path></svg></span></button><a class=\"hidden rounded-xl border border-[var(--border-default)] bg-[var(--surface-high)] px-4 py-2 text-xs font-bold uppercase tracking-[0.11em] text-[var(--text-primary)] transition hover:bg-[var(--surface-highest)] md:inline-flex\" href=\"/verifier\">Verify Receipt</a><a class=\"brand-gradient rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-[0.12em] text-white\" href=\"/admin/login\">Open Admin</a></div></div></header><section class=\"mx-auto max-w-7xl px-6 pb-20 pt-32 md:px-10\"><div class=\"mx-auto max-w-4xl text-center reveal-up reveal-slow reveal-delay-1\"><p class=\"inline-flex items-center gap-2 rounded-full border border-[var(--primary)]/25 bg-[var(--primary)]/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-[var(--tertiary)]\"><span class=\"h-1.5 w-1.5 rounded-full bg-emerald-400\"></span>Security And Compliance Standards</p><h1 class=\"mt-6 text-[2.8rem] font-extrabold leading-[0.98] tracking-[-0.04em] md:text-[4.4rem]\">Built For High-Trust Elections</h1><p class=\"mx-auto mt-5 max-w-3xl text-lg leading-relaxed text-[var(--text-muted)]\">Our platform applies layered cryptography, resilient infrastructure, and transparent auditing to protect election integrity from setup to publication.</p></div><section class=\"mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3 reveal-up reveal-slow reveal-delay-2\"><article class=\"glass-panel ghost-border rounded-[1.4rem] p-6 transition hover:bg-white/6\"><div class=\"mb-5 grid h-12 w-12 place-items-center rounded-xl bg-[var(--primary)]/12 text-[var(--primary)]\"><span class=\"material-symbols-outlined text-[26px]\">encrypted</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">End-to-End Ballot Encryption</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Votes are encrypted at origin and never exposed in plaintext across transport, storage, or tally pipelines.</p></article><article class=\"glass-panel ghost-border rounded-[1.4rem] p-6 transition hover:bg-white/6\"><div class=\"mb-5 grid h-12 w-12 place-items-center rounded-xl bg-[var(--primary)]/12 text-[var(--primary)]\"><span class=\"material-symbols-outlined text-[26px]\">key</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Hardware-Backed Key Management</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Cryptographic keys are isolated with strict rotation policies and tamper-evident access controls.</p></article><article class=\"glass-panel ghost-border rounded-[1.4rem] p-6 transition hover:bg-white/6\"><div class=\"mb-5 grid h-12 w-12 place-items-center rounded-xl bg-[var(--primary)]/12 text-[var(--primary)]\"><span class=\"material-symbols-outlined text-[26px]\">monitoring</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Continuous Threat Monitoring</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Live anomaly detection and risk scoring provide rapid incident response across election windows.</p></article><article class=\"glass-panel ghost-border rounded-[1.4rem] p-6 transition hover:bg-white/6\"><div class=\"mb-5 grid h-12 w-12 place-items-center rounded-xl bg-[var(--primary)]/12 text-[var(--primary)]\"><span class=\"material-symbols-outlined text-[26px]\">admin_panel_settings</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Zero-Trust Access</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Administrative actions require layered verification, scoped privileges, and full audit traceability.</p></article><article class=\"glass-panel ghost-border rounded-[1.4rem] p-6 transition hover:bg-white/6\"><div class=\"mb-5 grid h-12 w-12 place-items-center rounded-xl bg-[var(--primary)]/12 text-[var(--primary)]\"><span class=\"material-symbols-outlined text-[26px]\">verified_user</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Independent Verifiability</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Public receipts and Merkle proofs allow independent verification without disclosing voter identity.</p></article><article class=\"glass-panel ghost-border rounded-[1.4rem] p-6 transition hover:bg-white/6\"><div class=\"mb-5 grid h-12 w-12 place-items-center rounded-xl bg-[var(--primary)]/12 text-[var(--primary)]\"><span class=\"material-symbols-outlined text-[26px]\">history_toggle_off</span></div><h2 class=\"text-xl font-extrabold tracking-tight\">Immutable Audit Trails</h2><p class=\"mt-3 text-sm leading-relaxed text-[var(--text-muted)]\">Critical election events are recorded in append-only logs for transparent post-election review.</p></article></section><section class=\"mt-10 rounded-[1.8rem] border border-white/10 bg-[var(--surface-container)]/80 p-6 md:p-8 reveal-up reveal-slow reveal-delay-2\"><p class=\"text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--text-muted)]\">Assurance Profile</p><div class=\"mt-4 flex flex-wrap gap-3\"><span class=\"rounded-full border border-[var(--primary)]/25 bg-[var(--primary)]/10 px-4 py-1.5 text-xs font-semibold text-[var(--tertiary)]\">ISO 27001</span><span class=\"rounded-full border border-[var(--primary)]/25 bg-[var(--primary)]/10 px-4 py-1.5 text-xs font-semibold text-[var(--tertiary)]\">SOC 2 Type II</span><span class=\"rounded-full border border-[var(--primary)]/25 bg-[var(--primary)]/10 px-4 py-1.5 text-xs font-semibold text-[var(--tertiary)]\">NIST-Aligned Controls</span><span class=\"rounded-full border border-[var(--primary)]/25 bg-[var(--primary)]/10 px-4 py-1.5 text-xs font-semibold text-[var(--tertiary)]\">Regional Data Residency</span></div><p class=\"mt-4 max-w-3xl text-sm leading-relaxed text-[var(--text-muted)]\">Final compliance posture depends on deployment region, tenant configuration, and election authority policy controls.</p></section><section class=\"mt-12 rounded-[2rem] border border-white/10 bg-black/25 p-7 md:p-10 reveal-up reveal-slow reveal-delay-3\"><h2 class=\"text-3xl font-extrabold tracking-tight md:text-4xl\">Validate Security Through Public Proofs</h2><p class=\"mt-4 max-w-3xl text-base leading-relaxed text-[var(--text-muted)]\">Security is strongest when trust is testable. Use the public verifier to confirm receipt anchoring and proof continuity in the ledger.</p><div class=\"mt-7 flex flex-wrap gap-3\"><a class=\"brand-gradient rounded-xl px-7 py-3 text-sm font-bold uppercase tracking-[0.1em] text-white\" href=\"/verifier\">Open Verifier</a><a class=\"rounded-xl border border-[var(--border-default)] bg-[var(--surface-high)] px-7 py-3 text-sm font-bold uppercase tracking-[0.1em] text-[var(--text-primary)] transition hover:bg-[var(--surface-highest)]\" href=\"/\">Return Home</a></div></section></section></main><!--$--><!--/$--><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[13080,[\\\"/_next/static/chunks/06-w6o6puomke.js\\\"],\\\"AuthProvider\\\"]\\n3:I[39756,[\\\"/_next/static/chunks/06-w6o6puomke.js\\\"],\\\"default\\\"]\\n4:I[37457,[\\\"/_next/static/chunks/06-w6o6puomke.js\\\"],\\\"default\\\"]\\n5:I[22016,[\\\"/_next/static/chunks/06-w6o6puomke.js\\\",\\\"/_next/static/chunks/1cplzkomwqb35.js\\\"],\\\"\\\"]\\n6:I[94013,[\\\"/_next/static/chunks/06-w6o6puomke.js\\\",\\\"/_next/static/chunks/1cplzkomwqb35.js\\\"],\\\"ThemeToggle\\\"]\\nd:I[68027,[\\\"/_next/static/chunks/06-w6o6puomke.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/1hln_88z7nsa8.css\\\",\\\"style\\\"]\\nb:X\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"security\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"security\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4624],[[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\