vents-none absolute -right-24 top-[40%] h-[360px] w-[360px] rounded-full bg-[var(--tertiary)]/12 blur-[115px]\"></div><header class=\"fixed inset-x-0 top-0 z-30 border-b border-[var(--border-default)] bg-[var(--surface-overlay)] backdrop-blur-xl\"><div class=\"mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-5 md:px-8\"><a class=\"flex items-center gap-2 text-base font-extrabold tracking-tight\" href=\"/\"><span class=\"material-symbols-outlined text-[var(--primary)]\">security</span>SecureVote</a><button type=\"button\" aria-label=\"Switch to light mode\" title=\"Switch to light mode\" class=\"relative inline-flex h-8 w-12 items-center rounded-full border border-[var(--border-default)] bg-[var(--surface-high)] px-1 transition hover:border-[var(--border-strong)]\"><span class=\"absolute top-1 grid h-6 w-6 place-items-center rounded-full bg-[var(--surface)] text-[var(--text-secondary)] shadow-[0_2px_10px_rgba(0,0,0,0.25)] transition-all left-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-moon h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401\"></path></svg></span></button><nav class=\"hidden items-center gap-6 md:flex\"><a class=\"text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--text-muted)] transition hover:text-[var(--text-primary)]\" href=\"/\">Home</a><a class=\"text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--text-muted)] transition hover:text-[var(--text-primary)]\" href=\"/security\">Security</a><a class=\"text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--text-muted)] transition hover:text-[var(--text-primary)]\" href=\"/verifier\">Verifier</a></nav><a class=\"brand-gradient rounded-lg px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.1em] text-white\" href=\"/admin/login\">Sign In</a></div></header><section class=\"relative hidden w-1/2 flex-col justify-between overflow-hidden bg-[var(--surface-container-low)] px-12 py-10 lg:flex\"><div class=\"dot-grid absolute inset-0 opacity-35\"></div><div class=\"absolute -left-20 top-1/4 h-[360px] w-[360px] rounded-full bg-[var(--primary)]/15 blur-[120px]\"></div><div class=\"absolute -right-20 bottom-1/4 h-[320px] w-[320px] rounded-full bg-[var(--secondary)]/15 blur-[120px]\"></div><div class=\"relative z-10 flex items-center gap-3\"><div class=\"brand-gradient flex h-11 w-11 items-center justify-center rounded-xl\"><span class=\"material-symbols-outlined text-white\" style=\"font-variation-settings:&quot;FILL&quot; 1\">how_to_vote</span></div><div><p class=\"text-xl font-bold tracking-tight\">SecureVote</p><p class=\"text-[10px] font-semibold uppercase tracking-[0.2em] text-[var(--text-muted)]\">Enterprise Admin</p></div></div><div class=\"relative z-10 max-w-xl\"><h1 class=\"text-5xl font-bold leading-[1.05] tracking-[-0.03em]\">Reinforce your digital sovereignty</h1><p class=\"mt-5 text-base leading-relaxed text-[var(--text-muted)]\">Update your credentials to maintain encrypted access to the SecureVote governance infrastructure.</p><div class=\"mt-9 space-y-4\"><div class=\"flex items-start gap-4 rounded-xl bg-[var(--surface-container-high)]/45 p-3\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--surface-container-high)] text-[var(--primary)]\"><span class=\"material-symbols-outlined\">security</span></div><div><p class=\"text-sm font-semibold\">Military-grade security</p><p class=\"mt-1 text-xs text-[var(--text-muted)]\">End-to-end encrypted voting and audit-safe operations.</p></div></div><div class=\"flex items-start gap-4 rounded-xl bg-[var(--surface-container-high)]/45 p-3\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--surface-container-high)] text-[var(--primary)]\"><span class=\"material-symbols-outlined\">monitoring</span></div><div><p class=\"text-sm font-semibold\">Real-time governance telemetry</p><p class=\"mt-1 text-xs text-[var(--text-muted)]\">Monitor turnout, anomalies, and integrity in one command center.</p></div></div><div class=\"flex items-start gap-4 rounded-xl bg-[var(--surface-container-high)]/45 p-3\"><div class=\"flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--surface-container-high)] text-[var(--primary)]\"><span class=\"material-symbols-outlined\">corporate_fare</span></div><div><p class=\"text-sm font-semibold\">Multi-organization control</p><p class=\"mt-1 text-xs text-[var(--text-muted)]\">Manage institutions and elections with role-based precision.</p></div></div></div></div><div class=\"relative z-10 flex flex-wrap items-center gap-3\"><div class=\"glass-panel ghost-border flex items-center gap-2 rounded-full px-3 py-1.5\"><span class=\"h-1.5 w-1.5 rounded-full bg-emerald-400\"></span><span class=\"text-[10px] font-semibold uppercase tracking-[0.13em]\">50K+ Voters</span></div><div class=\"glass-panel ghost-border flex items-center gap-2 rounded-full px-3 py-1.5\"><span class=\"h-1.5 w-1.5 rounded-full bg-[var(--primary)]\"></span><span class=\"text-[10px] font-semibold uppercase tracking-[0.13em]\">99.9% Uptime</span></div><div class=\"glass-panel ghost-border flex items-center gap-2 rounded-full px-3 py-1.5\"><span class=\"h-1.5 w-1.5 rounded-full bg-[var(--secondary)]\"></span><span class=\"text-[10px] font-semibold uppercase tracking-[0.13em]\">256-bit Encrypted</span></div></div></section><section class=\"flex items-center justify-center px-6 py-12 pt-24 lg:px-16\"><div class=\"w-full max-w-[470px] space-y-6\"><div class=\"text-center reveal-up reveal-fast reveal-delay-1\"><div class=\"brand-gradient mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl\"><span class=\"material-symbols-outlined text-3xl text-white\" style=\"font-variation-settings:&quot;FILL&quot; 1\">lock_reset</span></div><h1 class=\"text-3xl font-bold\">Create new password</h1><p class=\"mt-2 text-[var(--text-muted)]\">Your new password must be different from previously used passwords.</p><p class=\"mx-auto mt-3 max-w-sm text-xs leading-relaxed text-white/55\">Password changes are recorded and tied to session risk telemetry for post-event investigation.</p></div><div class=\"glass-panel ghost-border flex items-center gap-3 rounded-xl px-4 py-3 reveal-up reveal-fast reveal-delay-2\"><span class=\"material-symbols-outlined text-[var(--tertiary)]\">schedule</span><span class=\"text-sm font-medium text-[var(--tertiary)]\">Reset link valid for 12 more minutes</span></div><form class=\"space-y-5 reveal-up reveal-fast reveal-delay-2\"><div><label class=\"mb-2 block text-xs font-semibold uppercase tracking-[0.11em] text-[var(--text-muted)]\">New Password</label><div class=\"relative\"><input type=\"password\" placeholder=\"Enter your new password\" class=\"w-full border-0 border-b border-white/15 bg-[var(--surface-container-low)] px-4 py-3 pr-20 text-sm outline-none transition focus:border-[var(--primary)]\" value=\"SecureVote@2026\"/><button type=\"button\" class=\"absolute right-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)]\"><span class=\"material-symbols-outlined text-base\">visibility</span></button></div></div><div class=\"space-y-2\"><div class=\"flex items-center justify-between text-xs\"><span class=\"font-semibold uppercase tracking-[0.11em] text-[var(--text-muted)]\">Password Strength</span><span class=\"font-bold text-emerald-400\">Strong</span></div><div class=\"grid h-1 grid-cols-4 gap-2\"><span class=\"rounded-full bg-emerald-400\"></span><span class=\"rounded-full bg-emerald-400\"></span><span class=\"rounded-full bg-emerald-400\"></span><span class=\"rounded-full bg-emerald-400\"></span></div></div><div class=\"ghost-border rounded-xl bg-[var(--surface-container)] p-5\"><p class=\"mb-3 text-xs font-semibold uppercase tracking-[0.11em] text-[var(-